bool is_intrnet_available() {
    char cmd[128];
    snprintf(cmd, sizeof(cmd), "ping -c 1 -W 3 %s > /dev/null 2>&1", PING_IP);

    int result = system(cmd);

    if (result == 0)
        return true;
    else
        return false;
}

void* ping_thread(void *arg)
{
    while (1) {
        network_ok = is_intrnet_available();

        if (network_ok)
            printf(" Network OK\n");
        else
            printf("Network FAIL\n");

        sleep(5);
    }
    return NULL;
}

