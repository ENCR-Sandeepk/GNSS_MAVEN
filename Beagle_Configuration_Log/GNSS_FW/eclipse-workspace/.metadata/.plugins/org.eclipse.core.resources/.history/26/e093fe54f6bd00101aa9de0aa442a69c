void* push_button_in_thread(void *arg)
{
while(1) {

      int val = gpiod_line_get_value(pb_in);
        if (val == 1) {
          gpiod_line_set_value(pb_led_red, ON);
          gpiod_line_set_value(pb_led_green, OFF);
        }else{

          gpiod_line_set_value(pb_led_green, ON);
          gpiod_line_set_value(pb_led_red, OFF);
         }
}

}


int main() {

    chip = gpiod_chip_open_by_name("gpiochip3");

    sw_led_red = gpiod_chip_get_line(chip, I2C_SDA); // Replace with your GPIO number
    sw_led_green = gpiod_chip_get_line(chip, I2C_SCK);

    gnss_pw_en 		 =	 gpiod_chip_get_line(chip, PWM);
    gsm_pw_en  		 = 	 gpiod_chip_get_line(chip, CIPI);
    gsm_IGT		 = 	 gpiod_chip_get_line(chip, SCK);
    pb_led_red 		 = 	 gpiod_chip_get_line(chip, CIPO);
    pb_led_green	 = 	 gpiod_chip_get_line(chip, CS);
    error		 = 	 gpiod_chip_get_line(chip, RST);
    pb_in		 =	 gpiod_chip_get_line(chip, INT);

   gpiod_line_request_output(sw_led_red, "beagleplay", OFF);
   gpiod_line_request_output(sw_led_green, "beagleplay", OFF);
   gpiod_line_request_output(gnss_pw_en, "beagleplay", OFF);
   gpiod_line_request_output(gsm_pw_en, "beagleplay", OFF);
   gpiod_line_request_output(gsm_IGT, "beagleplay", OFF);
   gpiod_line_request_output(pb_led_red, "beagleplay", OFF);
   gpiod_line_request_output(pb_led_green, "beagleplay", OFF);
   gpiod_line_request_output(error, "beagleplay", OFF);

   gpiod_line_request_input(pb_in, "gpio-input");
   sleep(1);

    printf("gpio initialized\n");

    gpiod_line_set_value(sw_led_red, ON);
    gpiod_line_set_value(sw_led_green, OFF);

    gpiod_line_set_value(gnss_pw_en, ENABLE);
    gpiod_line_set_value(gsm_pw_en, ENABLE);
    usleep(500000);  //ps settlement time 100 mS
    gpiod_line_set_value(gsm_IGT, HIGH);
    usleep(100000); // IGT pulse
    gpiod_line_set_value(gsm_IGT, LOW);

    gpiod_line_set_value(error, OFF);


    sleep(3);  //modem startup time 3 sec

    gpiod_line_release (gnss_pw_en);
    gpiod_line_release (gsm_pw_en);
    gpiod_line_release (gsm_IGT);


printf("gpio config done\n");

pthread_t t1, t2,t3,t4;

    pthread_create(&t1, NULL, ping_thread, NULL);
    pthread_create(&t2, NULL, led_thread, NULL);
    pthread_create(&t3, NULL, sys_stat_thread, NULL);
    pthread_create(&t4, NULL, push_button_in_thread, NULL);

    pthread_join(t1, NULL);
    pthread_join(t2, NULL);
    pthread_join(t3, NULL);
    pthread_join(t4, NULL);

    gpiod_line_release (sw_led_red); // Replace with your GPIO number
    gpiod_line_release (sw_led_green);

    gpiod_line_release (gnss_pw_en);
    gpiod_line_release (gsm_pw_en);
    gpiod_line_release (gsm_IGT);
    gpiod_line_release (pb_led_red);
    gpiod_line_release (pb_led_green);
    gpiod_line_release (error);

    gpiod_chip_close(chip);
    printf("program end \n");
    return 0;
}
